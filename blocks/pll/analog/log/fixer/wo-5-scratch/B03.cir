* osc
.include 'hdr.inc'
.include 'pB.inc'
.temp 27
vdd_src vdd 0 3.3
vss_src vss 0 0
ven pll_en 0 3.3
vup pfd_up 0 0
vdn pfd_dn 0 0
vt0 cp_trim0 0 0
vt1 cp_trim1 0 0
vvc vctrl 0 0.3
cload vco_out 0 15f
xdut vco_out pfd_up pfd_dn pll_en cp_trim0 cp_trim1 vctrl bias_ref vdd vss pll_analog
.control
tran 20p 150n 0 20p
meas tran r5x max v(xdut.r5) from=75n to=150n
meas tran r5n min v(xdut.r5) from=75n to=150n
meas tran ox max v(vco_out) from=75n to=150n
meas tran on min v(vco_out) from=75n to=150n
meas tran ta when v(xdut.r5)=1.4 rise=2 td=50n
meas tran tb when v(xdut.r5)=1.4 rise=4 td=50n
let fmhz = 2/(tb-ta)/1e6
print fmhz
meas tran ivdd avg i(vdd_src) from=75n to=150n
.endc
.end
