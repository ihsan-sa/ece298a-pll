[options]
size 20
seed 1

[script]
read_verilog -sv /home/ihsan/.cc/worktrees/ece298a/pll/blocks/pll/digital/rtl/ihsan_sa_pll.v
read_verilog -sv /home/ihsan/.cc/worktrees/ece298a/pll/blocks/pll/digital/rtl/pll_ctrl_regs.v
read_verilog -sv /home/ihsan/.cc/worktrees/ece298a/pll/blocks/pll/digital/rtl/pll_divider.v
read_verilog -sv /home/ihsan/.cc/worktrees/ece298a/pll/blocks/pll/digital/rtl/pll_lock_det.v
read_verilog -sv /home/ihsan/.cc/worktrees/ece298a/pll/blocks/pll/digital/rtl/pll_pfd.v
read_verilog -sv /home/ihsan/.cc/worktrees/ece298a/pll/blocks/pll/digital/rtl/pll_prescaler.v
hierarchy -top ihsan_sa_pll
proc

[logic]
if result("sim") == "FAIL":
    tag("KILLED")
else:
    tag("SURVIVED")

[test sim]
maxbatchsize 1
expect PASS FAIL
run python3 /home/ihsan/.claude/skills/chip-flow/engine/scripts/mutate_runner.py --tb /home/ihsan/.cc/worktrees/ece298a/pll/blocks/pll/digital/tb --top ihsan_sa_pll

[report]
print(f"mutants={tags()} killed={tags('KILLED')} survived={tags('SURVIVED')}")
